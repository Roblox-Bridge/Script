addButton(farmPage, "📍 TP to Nearest Mob", function()
    local mob = getNearestTargetMob()
    if mob then
        local mr = mob:FindFirstChild("HumanoidRootPart")
        if mr then
            local r = getRoot()
            if r then r.CFrame = CFrame.new(mr.Position + Vector3.new(0,8,0)) end
        end
    end
end)

