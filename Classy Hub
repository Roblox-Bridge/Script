-- Classy Hub v1.2 - Auto Quest Accept (No TP to Quest Giver) -- Feature: Player quest giver ke paas jayega hi nahi, background mein 1 sec mein quest accept print("Classy Hub v1.2 Loading - Auto Quest Background...") local Players = game:GetService("Players") local plr = Players.LocalPlayer repeat task.wait() until plr:FindFirstChild("Data") and plr.Data:FindFirstChild("Level") repeat task.wait() until plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") local ReplicatedStorage = game:GetService("ReplicatedStorage") local WS = game:GetService("Workspace") local TweenService = game:GetService("TweenService") getgenv().ClassyHub = getgenv().ClassyHub or {} getgenv().ClassyHub.AutoFarm = false getgenv().ClassyHub.StopTween = false getgenv().ClassyHub.TweenSpeed = 350 local QuestData = { ["Bandit"] = {QName = "BanditQuest1", QL = 1, M = CFrame.new(1045.96, 27, 1560.82)}, ["Monkey"] = {QName = "JungleQuest", QL = 1, M = CFrame.new(-1448.51, 68, 11.46)}, ["Gorilla"] = {QName = "JungleQuest", QL = 2, M = CFrame.new(-1129.88, 41, -525.42)}, ["Pirate"] = {QName = "BuggyQuest1", QL = 1, M = CFrame.new(-1103.51, 14, 3896.09)}, ["Brute"] = {QName = "BuggyQuest1", QL = 2, M = CFrame.new(-1140.08, 20, 4322.92)}, -- Your Level 50 ["Desert Bandit"] = {QName = "DesertQuest", QL = 1, M = CFrame.new(924.79, 7, 4481.58)}, ["Desert Officer"] = {QName = "DesertQuest", QL = 2, M = CFrame.new(1608.28, 9, 4371)}, } Mon, NameMon, NameQuest, LevelQuest, CFrameMon = nil, nil, nil, nil, nil function CheckQuest() local MyLevel = plr.Data.Level.Value if MyLevel <= 9 then Mon = "Bandit" elseif MyLevel <= 14 then Mon = "Monkey" elseif MyLevel <= 29 then Mon = "Gorilla" elseif MyLevel <= 39 then Mon = "Pirate" elseif MyLevel <= 59 then Mon = "Brute" -- Level 50 elseif MyLevel <= 74 then Mon = "Desert Bandit" elseif MyLevel <= 89 then Mon = "Desert Officer" else Mon = "Desert Bandit" end NameMon = Mon local data = QuestData[Mon] if data then NameQuest = data.QName LevelQuest = data.QL CFrameMon = data.M end end function HasQuest() local ok, res = pcall(function() local main = plr.PlayerGui:FindFirstChild("Main") if not main then return false end local q = main:FindFirstChild("Quest") if not q or not q.Visible then return false end local title = q.Container.QuestTitle.Title.Text if title == "" then return false end -- Check if quest contains our monster if title:find(Mon) or title:find("Pirate") or title:find("Brute") then return true end return true -- Any quest visible = has quest end) return ok and res or false end local CurrentTween = nil -- Sky Tween (water fix) function topos(targetCF) if getgenv().ClassyHub.StopTween then return end local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end local dist = (hrp.Position - targetCF.Position).Magnitude if dist < 25 then hrp.CFrame = targetCF + Vector3.new(0,10,0) return end if CurrentTween then pcall(function() CurrentTween:Cancel() end) end -- Up local upCF = CFrame.new(hrp.Position.X, 300, hrp.Position.Z) CurrentTween = TweenService:Create(hrp, TweenInfo.new(0.7, Enum.EasingStyle.Linear), {CFrame = upCF}) CurrentTween:Play() CurrentTween.Completed:Wait() if getgenv().ClassyHub.StopTween then return end -- High travel local highTarget = CFrame.new(targetCF.Position.X, 300, targetCF.Position.Z) local distHigh = (Vector3.new(hrp.Position.X,0,hrp.Position.Z) - Vector3.new(targetCF.Position.X,0,targetCF.Position.Z)).Magnitude CurrentTween = TweenService:Create(hrp, TweenInfo.new(distHigh/350, Enum.EasingStyle.Linear), {CFrame = highTarget}) CurrentTween:Play() CurrentTween.Completed:Wait() if getgenv().ClassyHub.StopTween then return end -- Down CurrentTween = TweenService:Create(hrp, TweenInfo.new(0.7, Enum.EasingStyle.Linear), {CFrame = targetCF + Vector3.new(0,10,0)}) CurrentTween:Play() CurrentTween.Completed:Wait() end function StopTween(farming) getgenv().ClassyHub.StopTween = not farming if CurrentTween then pcall(function() CurrentTween:Cancel() end) CurrentTween = nil end end -- NEW: Auto Quest Accept in Background (no need to go to quest giver) function AutoAcceptQuest() pcall(function() -- Abandon if too far or wrong quest local main = plr.PlayerGui:FindFirstChild("Main") if main and main:FindFirstChild("Quest") and main.Quest.Visible then local title = main.Quest.Container.QuestTitle.Title.Text if not title:find(Mon) and title ~= "" then ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest") task.wait(0.3) end end -- Direct accept in 0.5 sec - no TP needed! ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest) task.wait(0.5) -- Try twice for guarantee ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest) end) end -- UI local guiParent = plr.PlayerGui local gui = Instance.new("ScreenGui", guiParent) gui.Name = "ClassyHub_v1_2" gui.ResetOnSpawn = false local main = Instance.new("Frame", gui) main.Size = UDim2.new(0,270,0,150) main.Position = UDim2.new(0,20,0,180) main.BackgroundColor3 = Color3.fromRGB(20,20,20) Instance.new("UICorner", main).CornerRadius = UDim.new(0,12) local title = Instance.new("TextLabel", main) title.Size = UDim2.new(1,0,0,30) title.Text = "Classy Hub v1.2 - Auto Quest" title.TextColor3 = Color3.new(1,1,1) title.BackgroundTransparency = 1 title.Font = Enum.Font.GothamBold title.TextSize = 14 local debug = Instance.new("TextLabel", main) debug.Size = UDim2.new(0,250,0,20) debug.Position = UDim2.new(0,10,0,30) debug.Text = "Lv: "..plr.Data.Level.Value.." | Auto Accept ON" debug.BackgroundTransparency = 1 debug.TextColor3 = Color3.fromRGB(0,255,100) debug.Font = Enum.Font.Gotham debug.TextSize = 12 local btnFarm = Instance.new("TextButton", main) btnFarm.Size = UDim2.new(0,250,0,45) btnFarm.Position = UDim2.new(0,10,0,55) btnFarm.Text = "Auto Farm: OFF" btnFarm.BackgroundColor3 = Color3.fromRGB(170,0,0) btnFarm.TextColor3 = Color3.new(1,1,1) btnFarm.Font = Enum.Font.GothamBold btnFarm.TextSize = 15 Instance.new("UICorner", btnFarm).CornerRadius = UDim.new(0,8) local status = Instance.new("TextLabel", main) status.Size = UDim2.new(0,250,0,30) status.Position = UDim2.new(0,10,0,110) status.Text = "Quest giver TP removed - Direct accept" status.BackgroundTransparency = 1 status.TextColor3 = Color3.fromRGB(180,180,180) status.Font = Enum.Font.Gotham status.TextSize = 11 btnFarm.MouseButton1Click:Connect(function() getgenv().ClassyHub.AutoFarm = not getgenv().ClassyHub.AutoFarm StopTween(getgenv().ClassyHub.AutoFarm) btnFarm.Text = getgenv().ClassyHub.AutoFarm and "Auto Farm: ON - Auto Quest" or "Auto Farm: OFF" btnFarm.BackgroundColor3 = getgenv().ClassyHub.AutoFarm and Color3.fromRGB(0,150,0) or Color3.fromRGB(170,0,0) end) -- MAIN LOOP - NO QUEST GIVER TP spawn(function() while task.wait(0.3) do if getgenv().ClassyHub.AutoFarm then pcall(function() CheckQuest() if not Mon then return end local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end if not HasQuest() then status.Text = "Auto Accepting: "..NameQuest.." in background..." -- NO topos(CFrameQuest) - direct accept! AutoAcceptQuest() debug.Text = "Lv: "..plr.Data.Level.Value.." | Trying: "..NameQuest.." Lv"..LevelQuest task.wait(1) -- 1 sec as you asked else -- Has quest, go to mobs only local target = nil for _,v in pairs(WS.Enemies:GetChildren()) do if v.Name == Mon and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then if (v.HumanoidRootPart.Position - hrp.Position).Magnitude < 1500 then target = v break end end end -- If no nearby, find any if not target then for _,v in pairs(WS.Enemies:GetChildren()) do if v.Name == Mon and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then target = v break end end end if target and target:FindFirstChild("HumanoidRootPart") then status.Text = "Killing: "..Mon.." | Quest Auto Accepted" topos(target.HumanoidRootPart.CFrame * CFrame.new(0,18,0)) -- Bring + NoClip for _,v in pairs(WS.Enemies:GetChildren()) do if v.Name == Mon and v:FindFirstChild("HumanoidRootPart") and (v.HumanoidRootPart.Position - hrp.Position).Magnitude < 400 then v.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0,0,4) v.HumanoidRootPart.CanCollide = false v.Humanoid.WalkSpeed = 0 v.Humanoid.JumpPower = 0 end end -- Fast Attack local tool = plr.Character:FindFirstChildOfClass("Tool") if tool then tool:Activate() pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("Attack", true) end) end else status.Text = "Going to Spawn: "..Mon.." (no TP to quest giver)" topos(CFrameMon) end end end) end end end) print("Classy Hub v1.2 Loaded - No Quest Giver TP, Auto Accept in 1 sec!")
