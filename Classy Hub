-- ================================================
-- Blox Fruits Auto Farm v1.0
-- Context: Roblox client-side Lua (executed via exploit executor)
-- Target: Blox Fruits (any sea)
-- Arch: Client-side memory/game object manipulation
-- ================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- ================================================
-- CONFIG (edit these)
-- ================================================
local CONFIG = {
    AutoFarm       = true,
    AutoMobs       = true,
    AutoCollectFruit = true,
    AutoQuest      = true,
    WalkSpeed      = 50,        -- default 16
    JumpPower      = 100,
    FarmRadius     = 150,       -- studs radius to detect mobs
    TeleportOffset = Vector3.new(0, 3, 0),
    AttackDelay    = 0.1,       -- seconds between attacks
    RespawnDelay   = 2.0,
    TargetMobs     = {},        -- empty = all mobs, fill with names to whitelist
    BlacklistMobs  = {"Dummy"}, -- mobs to ignore
}

-- ================================================
-- UTILITIES
-- ================================================

local function getCharacter()
    return LocalPlayer.Character
end

local function getRootPart()
    local char = getCharacter()
    if char then return char:FindFirstChild("HumanoidRootPart") end
end

local function getHumanoid()
    local char = getCharacter()
    if char then return char:FindFirstChildOfClass("Humanoid") end
end

local function isAlive()
    local hum = getHumanoid()
    return hum and hum.Health > 0
end

local function teleportTo(position)
    local root = getRootPart()
    if root then
        root.CFrame = CFrame.new(position + CONFIG.TeleportOffset)
    end
end

local function distanceTo(pos)
    local root = getRootPart()
    if root then
        return (root.Position - pos).Magnitude
    end
    return math.huge
end

local function setStats()
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = CONFIG.WalkSpeed
        hum.JumpPower = CONFIG.JumpPower
    end
end

-- ================================================
-- MOB DETECTION
-- ================================================

local function isValidMob(model)
    -- Must have humanoid and humanoidrootpart
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum.Health <= 0 then return false end

    -- Not the local player
    if model.Name == LocalPlayer.Name then return false end

    -- Not a player
    for _, v in ipairs(Players:GetPlayers()) do
        if v.Character == model then return false end
    end

    -- Blacklist check
    for _, blacklisted in ipairs(CONFIG.BlacklistMobs) do
        if model.Name == blacklisted then return false end
    end

    -- Whitelist check (if populated)
    if #CONFIG.TargetMobs > 0 then
        local found = false
        for _, allowed in ipairs(CONFIG.TargetMobs) do
            if model.Name:lower():find(allowed:lower()) then
                found = true
                break
            end
        end
        if not found then return false end
    end

    return true
end

local function getNearestMob()
    local nearest = nil
    local nearestDist = math.huge
    local root = getRootPart()
    if not root then return nil end

    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and isValidMob(model) then
            local mobRoot = model:FindFirstChild("HumanoidRootPart")
            if mobRoot then
                local dist = (root.Position - mobRoot.Position).Magnitude
                if dist < nearestDist and dist <= CONFIG.FarmRadius then
                    nearest = model
                    nearestDist = dist
                end
            end
        end
    end

    return nearest
end

-- ================================================
-- AUTO ATTACK
-- ================================================

local function clickMob(mob)
    -- Simulate click on mob using mouse service
    -- Works on most executors that support mouse1click
    local mouse = LocalPlayer:GetMouse()
    if mouse and mob then
        local mobRoot = mob:FindFirstChild("HumanoidRootPart")
        if mobRoot then
            -- Move camera target
            local cam = Workspace.CurrentCamera
            cam.CFrame = CFrame.new(cam.CFrame.Position, mobRoot.Position)
            mouse.Target = mobRoot
            -- Trigger click
            fireclickdetector(mobRoot) -- works on some executors
        end
    end
end

local function useEquippedTool(mob)
    -- Use currently equipped tool (sword/gun)
    local char = getCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local activateEvent = tool:FindFirstChildOfClass("RemoteEvent")
            or tool:FindFirstChild("RemoteEvent")
        -- Try to fire tool activation
        if tool.Handle then
            -- Simulate activation
            local event = tool:FindFirstChild("Activated")
            if event then event:Fire() end
        end
        -- Executor-level simulation
        pcall(function()
            tool:Activate()
        end)
    end
end

-- ================================================
-- AUTO QUEST
-- ================================================

local function acceptQuest()
    -- Attempt to auto-accept nearest quest NPC
    -- Blox Fruits uses RemoteEvents for quest acceptance
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        or ReplicatedStorage:FindFirstChild("Events")
    if not remotes then return end

    -- Common quest remote name patterns in Blox Fruits
    local questRemotes = {
        "startQuest",
        "StartQuest",
        "AcceptQuest",
        "QuestStart"
    }

    for _, remoteName in ipairs(questRemotes) do
        local remote = remotes:FindFirstChild(remoteName)
        if remote and remote:IsA("RemoteEvent") then
            pcall(function()
                remote:FireServer()
            end)
        end
    end
end

-- ================================================
-- AUTO FRUIT COLLECT
-- ================================================

local function collectNearbyFruits()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- Blox Fruits on map typically named with "Fruit" or specific fruit names
        if obj:IsA("Model") and (
            obj.Name:lower():find("fruit") or
            obj.Name:lower():find("devil")
        ) then
            local part = obj:FindFirstChildOfClass("BasePart")
                or obj:FindFirstChild("Handle")
            if part then
                local dist = distanceTo(part.Position)
                if dist < 30 then
                    -- Teleport to fruit and attempt pickup
                    teleportTo(part.Position)
                    task.wait(0.3)
                    -- Fire any touch events
                    pcall(function()
                        firetouchinterest(getRootPart(), part, 0)
                        task.wait(0.1)
                        firetouchinterest(getRootPart(), part, 1)
                    end)
                end
            end
        end
    end
end

-- ================================================
-- MAIN FARM LOOP
-- ================================================

local farmConnection
local function startFarm()
    if farmConnection then
        farmConnection:Disconnect()
    end

    farmConnection = RunService.Heartbeat:Connect(function()
        if not CONFIG.AutoFarm then return end
        if not isAlive() then
            task.wait(CONFIG.RespawnDelay)
            return
        end

        setStats()

        -- Auto collect fruits
        if CONFIG.AutoCollectFruit then
            collectNearbyFruits()
        end

        -- Auto quest
        if CONFIG.AutoQuest then
            acceptQuest()
        end

        -- Find and attack nearest mob
        if CONFIG.AutoMobs then
            local mob = getNearestMob()
            if mob then
                local mobRoot = mob:FindFirstChild("HumanoidRootPart")
                if mobRoot then
                    -- Teleport close to mob
                    teleportTo(mobRoot.Position)
                    task.wait(CONFIG.AttackDelay)
                    -- Attack sequence
                    clickMob(mob)
                    useEquippedTool(mob)
                    task.wait(CONFIG.AttackDelay)
                end
            else
                -- No mob in radius, wait
                task.wait(0.5)
            end
        end
    end)

    print("[AutoFarm] Started 💀")
end

local function stopFarm()
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
        print("[AutoFarm] Stopped ✌️")
    end
end

-- ================================================
-- CHARACTER RESPAWN HANDLER
-- ================================================

LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    HumanoidRootPart = newChar:WaitForChild("HumanoidRootPart")
    Humanoid = newChar:WaitForChild("Humanoid")
    task.wait(CONFIG.RespawnDelay)
    if CONFIG.AutoFarm then
        startFarm()
    end
end)

-- ================================================
-- SIMPLE TOGGLE UI (optional, key bind)
-- ================================================

local UserInputService = game:GetService("UserInputService")

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    -- Press F to toggle farm on/off
    if input.KeyCode == Enum.KeyCode.F then
        CONFIG.AutoFarm = not CONFIG.AutoFarm
        if CONFIG.AutoFarm then
            startFarm()
        else
            stopFarm()
        end
        print("[AutoFarm] Toggled:", CONFIG.AutoFarm)
    end
end)

-- ================================================
-- INIT
-- ================================================

print("[AutoFarm] Loaded — Press F to toggle 😩")
startFarm()
