-- ================================================
-- Blox Fruits Auto Farm — Full Dashboard UI
-- Context: Roblox client-side Lua (exploit executor)
-- UI Lib: Rayfield
-- Tabs: Farm | Stats | Fruit | Settings
-- ================================================

-- ================================================
-- LOAD RAYFIELD
-- ================================================
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

-- ================================================
-- SERVICES
-- ================================================
local Players         = game:GetService("Players")
local RunService      = game:GetService("RunService")
local UserInputService= game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace       = game:GetService("Workspace")
local Stats           = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

-- ================================================
-- CONFIG STATE
-- ================================================
local CONFIG = {
    -- Farm
    AutoFarm         = false,
    AutoMobs         = true,
    AutoCollectFruit = true,
    AutoQuest        = true,
    FarmRadius       = 150,
    AttackDelay      = 0.1,
    RespawnDelay     = 2.0,
    -- Stats
    AutoAllocStats   = false,
    StatPriority     = "Melee", -- Melee | Defense | Sword | Gun | Fruit
    -- Settings
    WalkSpeed        = 50,
    JumpPower        = 100,
    AntiAFK          = true,
    ESP              = false,
    TargetMobs       = {},
    BlacklistMobs    = {"Dummy"},
}

-- Runtime
local farmConnection  = nil
local antiAFKConn     = nil
local espObjects      = {}

-- ================================================
-- UTILITIES
-- ================================================
local function getChar()   return LocalPlayer.Character end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive()
    local h = getHum()
    return h and h.Health > 0
end
local function distanceTo(pos)
    local r = getRoot()
    return r and (r.Position - pos).Magnitude or math.huge
end
local function teleportTo(pos)
    local r = getRoot()
    if r then r.CFrame = CFrame.new(pos + Vector3.new(0,3,0)) end
end
local function setStats()
    local h = getHum()
    if h then
        h.WalkSpeed = CONFIG.WalkSpeed
        h.JumpPower = CONFIG.JumpPower
    end
end

-- ================================================
-- MOB DETECTION
-- ================================================
local function isValidMob(model)
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum.Health <= 0 then return false end
    if model.Name == LocalPlayer.Name then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    for _, b in ipairs(CONFIG.BlacklistMobs) do
        if model.Name == b then return false end
    end
    return true
end

local function getNearestMob()
    local nearest, nearDist = nil, math.huge
    local root = getRoot()
    if not root then return nil end
    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isValidMob(m) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mr then
                local d = (root.Position - mr.Position).Magnitude
                if d < nearDist and d <= CONFIG.FarmRadius then
                    nearest, nearDist = m, d
                end
            end
        end
    end
    return nearest
end

-- ================================================
-- COMBAT
-- ================================================
local function attackMob(mob)
    local mobRoot = mob:FindFirstChild("HumanoidRootPart")
    if not mobRoot then return end
    local char = getChar()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
    pcall(function() fireclickdetector(mobRoot) end)
    pcall(function()
        firetouchinterest(getRoot(), mobRoot, 0)
        task.wait(0.05)
        firetouchinterest(getRoot(), mobRoot, 1)
    end)
end

-- ================================================
-- AUTO QUEST
-- ================================================
local function acceptQuest()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        or ReplicatedStorage:FindFirstChild("Events")
    if not remotes then return end
    for _, name in ipairs({"startQuest","StartQuest","AcceptQuest","QuestStart"}) do
        local r = remotes:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then
            pcall(function() r:FireServer() end)
        end
    end
end

-- ================================================
-- FRUIT COLLECT
-- ================================================
local function collectFruits()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (
            obj.Name:lower():find("fruit") or
            obj.Name:lower():find("devil")
        ) then
            local part = obj:FindFirstChildOfClass("BasePart")
                      or obj:FindFirstChild("Handle")
            if part and distanceTo(part.Position) < 30 then
                teleportTo(part.Position)
                task.wait(0.3)
                pcall(function()
                    firetouchinterest(getRoot(), part, 0)
                    task.wait(0.1)
                    firetouchinterest(getRoot(), part, 1)
                end)
            end
        end
    end
end

-- ================================================
-- AUTO STAT ALLOCATION
-- ================================================
local statMap = {
    Melee   = "STR",
    Defense = "DEF",
    Sword   = "SWD",
    Gun     = "GUN",
    Fruit   = "DF",
}
local function allocateStat()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    local addStat = remotes:FindFirstChild("AddStat")
        or remotes:FindFirstChild("StatAdd")
    if addStat then
        pcall(function()
            addStat:FireServer(statMap[CONFIG.StatPriority] or "STR")
        end)
    end
end

-- ================================================
-- ANTI-AFK
-- ================================================
local function startAntiAFK()
    if antiAFKConn then antiAFKConn:Disconnect() end
    antiAFKConn = RunService.Heartbeat:Connect(function()
        if not CONFIG.AntiAFK then return end
        -- Virtual input to prevent kick
        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            VIM:SendKeyEvent(true,  "W", false, game)
            VIM:SendKeyEvent(false, "W", false, game)
        end)
    end)
end

-- ================================================
-- ESP
-- ================================================
local function clearESP()
    for _, v in ipairs(espObjects) do
        pcall(function() v:Destroy() end)
    end
    espObjects = {}
end

local function drawESP()
    clearESP()
    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and isValidMob(model) then
            local mr = model:FindFirstChild("HumanoidRootPart")
            if mr then
                local box = Instance.new("SelectionBox")
                box.Adornee = model
                box.Color3 = Color3.fromRGB(255, 50, 50)
                box.LineThickness = 0.05
                box.SurfaceTransparency = 0.7
                box.Parent = Workspace
                table.insert(espObjects, box)
            end
        end
    end
end

-- ================================================
-- MAIN FARM LOOP
-- ================================================
local function startFarm()
    if farmConnection then farmConnection:Disconnect() end
    farmConnection = RunService.Heartbeat:Connect(function()
        if not CONFIG.AutoFarm then return end
        if not isAlive() then task.wait(CONFIG.RespawnDelay) return end
        setStats()
        if CONFIG.AutoCollectFruit then collectFruits() end
        if CONFIG.AutoQuest        then acceptQuest()    end
        if CONFIG.AutoAllocStats   then allocateStat()   end
        if CONFIG.AutoMobs then
            local mob = getNearestMob()
            if mob then
                local mr = mob:FindFirstChild("HumanoidRootPart")
                if mr then
                    teleportTo(mr.Position)
                    task.wait(CONFIG.AttackDelay)
                    attackMob(mob)
                    task.wait(CONFIG.AttackDelay)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

local function stopFarm()
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
end

-- ================================================
-- RESPAWN HANDLER
-- ================================================
LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(CONFIG.RespawnDelay)
    if CONFIG.AutoFarm then startFarm() end
end)

