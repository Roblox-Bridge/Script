addSection(statsPage, "LIVE INFO")

local hpLbl     = addInfoBox(statsPage, "❤️ HP: —")
local levelLbl  = addInfoBox(statsPage, "⭐ Level: —")
local targetLbl = addInfoBox(statsPage, "🎯 Target: None")
local questLbl  = addInfoBox(statsPage, "📋 Zone: —")

-- Live update
RunService.Heartbeat:Connect(function()
    local hum   = getHum()
    local hp    = hum and math.floor(hum.Health) or 0
    local maxhp = hum and math.floor(hum.MaxHealth) or 0
    local lv    = getLevel()
    local qData = getQuestForLevel(lv)

    pcall(function()
        hpLbl.Text     = "❤️ HP: " .. hp .. " / " .. maxhp
        levelLbl.Text  = "⭐ Level: " .. lv
        targetLbl.Text = "🎯 Target: " .. (currentTarget or "None")
        questLbl.Text  = "📋 Zone: " .. (qData and qData.island or "Unknown")
        questInfoLabel.Text = "Quest Zone: " .. (qData and qData.island or "?")
            .. "\nMobs: " .. (qData and table.concat(qData.mobs, ", "):sub(1,40) or "?")
    end)
end)

