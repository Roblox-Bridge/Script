-- ================================================
-- UTILITIES
-- ================================================
local function getChar()  return LocalPlayer.Character end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive()
    local h = getHum()
    return h and h.Health > 0
end
local function getLevel()
    -- Try to read level from leaderboard
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        local lv = stats:FindFirstChild("Level") or stats:FindFirstChild("Lv")
        if lv then return lv.Value end
    end
    return 1
end
local function distanceTo(pos)
    local r = getRoot()
    return r and (r.Position - pos).Magnitude or math.huge
end

-- Hover ABOVE mob position
local function teleportAboveMob(mobRoot)
    local r = getRoot()
    if r and mobRoot then
        r.CFrame = CFrame.new(
            mobRoot.Position + Vector3.new(0, CONFIG.HoverHeight, 0)
        )
    end
end

local function setMovement()
    local h = getHum()
    if h then
        -- ONLY set speed, do NOT touch controls or camera
        h.WalkSpeed = CONFIG.WalkSpeed
        h.JumpPower = CONFIG.JumpPower
    end
end

-- ================================================
-- MOB FILTERING — SMART
-- ================================================
local function isCombatMob(model)
    -- Must have humanoid
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    if not model:FindFirstChild("HumanoidRootPart") then return false end

    local hum = model:FindFirstChildOfClass("Humanoid")
    -- Must be alive
    if hum.Health <= 0 then return false end
    -- Must not be local player
    if model.Name == LocalPlayer.Name then return false end
    -- Must not be another player
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    -- Must not be a known vendor/quest NPC
    if NON_COMBAT_NPCS[model.Name] == true then return false end

    return true
end

local function isTargetMob(model)
    if not isCombatMob(model) then return false end
    local level = getLevel()
    local questData = getQuestForLevel(level)
    if not questData then return true end

    -- Check if mob name matches current quest mobs
    local mobNameLower = model.Name:lower()
    for _, mobName in ipairs(questData.mobs) do
        if mobNameLower:find(mobName:lower()) then
            return true
        end
    end
    return false
end

local function getNearestTargetMob()
    local nearest, nearDist = nil, math.huge
    local root = getRoot()
    if not root then return nil end

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isTargetMob(m) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mr then
                local d = (root.Position - mr.Position).Magnitude
                if d < nearDist and d <= CONFIG.FarmRadius then
                    nearest, nearDist = m, d
                end
            end
        end
    end
    return nearest
end

-- ================================================
-- BRING MOBS TO PLAYER
-- ================================================
local function bringMobsToPlayer()
    if not CONFIG.BringMobs then return end
    local root = getRoot()
    if not root then return end

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isTargetMob(m) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            local mobHum = m:FindFirstChildOfClass("Humanoid")
            if mr and mobHum and mobHum.Health > 0 then
                local dist = (root.Position - mr.Position).Magnitude
                if dist <= CONFIG.FarmRadius and dist > CONFIG.BringRadius then
                    -- Teleport mob root to near player
                    pcall(function()
                        mr.CFrame = CFrame.new(
                            root.Position + Vector3.new(
                                math.random(-8, 8), 0, math.random(-8, 8)
                            )
                        )
                    end)
                end
            end
        end
    end
end

-- ================================================
-- COMBAT — HOVER + AOE DAMAGE
-- ================================================
local function attackAllNearby()
    local root = getRoot()
    if not root then return end
    local char = getChar()
    if not char then return end

    -- Use equipped tool on all nearby mobs
    local tool = char:FindFirstChildOfClass("Tool")

    for _, m in ipairs(Workspace:GetDescendants()) do
        if m:IsA("Model") and isTargetMob(m) then
            local mr = m:FindFirstChild("HumanoidRootPart")
            if mr then
                local dist = (root.Position - mr.Position).Magnitude
                if dist <= CONFIG.BringRadius then
                    -- Fire touch damage
                    pcall(function()
                        firetouchinterest(root, mr, 0)
                        firetouchinterest(root, mr, 1)
                    end)
                    pcall(function()
                        fireclickdetector(mr)
                    end)
                    -- Activate tool
                    if tool then
                        pcall(function() tool:Activate() end)
                    end
                end
            end
        end
    end
end

-- ================================================
-- AUTO QUEST — LEVEL AWARE
-- ================================================
local function acceptLevelQuest()
    local level = getLevel()
    local questData = getQuestForLevel(level)
    if not questData then return end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        or ReplicatedStorage:FindFirstChild("Events")
    if not remotes then return end

    -- Try common quest remote names
    for _, name in ipairs({
        "startQuest", "StartQuest", "AcceptQuest",
        "QuestStart", "GiveQuest", "TakeQuest"
    }) do
        local r = remotes:FindFirstChild(name)
        if r and r:IsA("RemoteEvent") then
            pcall(function() r:FireServer(questData.island) end)
            pcall(function() r:FireServer() end)
        end
    end
end

-- ================================================
-- FRUIT COLLECT
-- ================================================
local function collectFruits()
    local root = getRoot()
    if not root then return end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (
            obj.Name:lower():find("fruit") or
            obj.Name:lower():find("devil")
        ) then
            local part = obj:FindFirstChildOfClass("BasePart")
                      or obj:FindFirstChild("Handle")
            if part then
                local dist = (root.Position - part.Position).Magnitude
                if dist < 40 then
                    pcall(function()
                        root.CFrame = CFrame.new(part.Position + Vector3.new(0,3,0))
                    end)
                    task.wait(0.2)
                    pcall(function()
                        firetouchinterest(root, part, 0)
                        task.wait(0.1)
                        firetouchinterest(root, part, 1)
                    end)
                end
            end
        end
    end
end

-- ================================================
-- STAT ALLOCATOR
-- ================================================
local statMap = {Melee="STR",Defense="DEF",Sword="SWD",Gun="GUN",Fruit="DF"}
local function allocateStat()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    local r = remotes:FindFirstChild("AddStat") or remotes:FindFirstChild("StatAdd")
    if r then pcall(function() r:FireServer(statMap[CONFIG.StatPriority] or "STR") end) end
end

-- ================================================
-- ANTI AFK — safe jump, no control interference
-- ================================================
local function startAntiAFK()
    if antiAFKConn then antiAFKConn:Disconnect() end
    local t = 0
    antiAFKConn = RunService.Heartbeat:Connect(function(dt)
        if not CONFIG.AntiAFK then return end
        t = t + dt
        if t >= 55 then
            t = 0
            local hum = getHum()
            if hum then
                -- Safe jump via humanoid, not keyboard
                hum.Jump = true
                task.wait(0.1)
                hum.Jump = false
            end
        end
    end)
end

