--// Utils
local Utils = {}
function Utils:HasItem(name)
    local inv = CommF:InvokeServer("getInventory")
    if inv then for _,v in pairs(inv) do if v.Name == name or v.Name == name:gsub(" %(1st Form%)","") then return true end end end
    return LocalPlayer.Backpack:FindFirstChild(name) ~= nil or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name) ~= nil)
end
function Utils:TableFind(t,val) for _,v in pairs(t) do if v==val then return true end end return false end
function Utils:Tween(cf)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - cf.Position).Magnitude
    TweenService:Create(hrp, TweenInfo.new(math.clamp(dist/300,0.1,5), Enum.EasingStyle.Linear), {CFrame=cf}):Play()
end

